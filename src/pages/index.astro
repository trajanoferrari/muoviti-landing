---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Interstizio from '../components/Interstizio.astro';
import Numeri from '../components/Numeri.astro';
import Valore from '../components/Valore.astro';
import Video from '../components/Video.astro';
import Metodo from '../components/Metodo.astro';
import ChiSono from '../components/ChiSono.astro';
import Percorso from '../components/Percorso.astro';
import Testimonianze from '../components/Testimonianze.astro';
import ComeLavoriamo from '../components/ComeLavoriamo.astro';
import Contatto from '../components/Contatto.astro';
import DiarioPreview from '../components/DiarioPreview.astro';
import WhatsAppFisso from '../components/WhatsAppFisso.astro';
---

<Base
  titolo="Trajano Ferrari — Cardio Dance Brasil a Catania"
  descrizione="Cardio Dance Brasil a Catania. Sala piena tre mattine a settimana, tutto l'anno. Lezione dimostrativa gratuita."
>
  <Hero />

  <main>
    <!-- Corte 1 do celular: repete a sub do hero e a legenda dos
         números, que vem logo depois. Três vezes o mesmo fato em
         duas telas. -->
    <Interstizio
      indice={1}
      soloDesktop
      testo="Ore 9 del mattino. Tre volte a settimana. Anche a luglio."
    />

    <Numeri />
    <Valore />

    <!-- A tese da página. Não repete nada, fica sempre. -->
    <Interstizio
      indice={2}
      testo="Riempire una lezione è facile. Difficile è riempirla di nuovo la settimana dopo."
    />

    <Video />
    <Metodo />

    <!-- Corte 1: repete literalmente o "13 anni davanti a una sala"
         dos números. -->
    <Interstizio
      indice={3}
      soloDesktop
      testo="Tredici anni davanti a una sala. Gli ultimi quattro a Catania."
    />

    <ChiSono />
    <Percorso />
    <Testimonianze />

    <!-- O quarto interstício, que o briefing anunciava e não
         detalhava. Decisão 7: antecipa a aula grátis e assume o
         risco em voz alta, na transição de prova para proposta. -->
    <Interstizio
      indice={4}
      testo="La prima lezione la offro io. Se non funziona, non se ne parla più."
    />

    <ComeLavoriamo />
    <Contatto />
    <!-- Busca os posts no navegador e só aparece se houver algum. -->
    <DiarioPreview />
  </main>

  <WhatsAppFisso />
</Base>

<script>
  // FASE 3. Três coisas, nada além: contador, reveals de seção e o
  // botão fixo. Sem parallax, sem cursor custom, sem scroll hijacking.
  // Zero biblioteca de animação: IntersectionObserver + CSS + rAF.
  import { avviaContatore } from '../lib/countUp';
  import { avviaReveal, avviaBottoneFisso } from '../lib/reveal';

  avviaReveal();
  avviaContatore();
  avviaBottoneFisso();
</script>
