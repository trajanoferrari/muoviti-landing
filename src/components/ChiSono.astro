---
// A frase do marketing sai do meio do parágrafo e vira destaque:
// é ela que explica por que a aula enche. Ele pensa a aula como
// espetáculo, não como treino. Ver PLANO.md, seção 3.
//
// A última frase fica sozinha — é um CTA disfarçado.
//
// PENDENTE: as fotos são as que existem no repositório. A seleção
// definitiva de 3 fotos do Brasil é pendência do Trajano, e as
// datas são as que consegui inferir do material.
const foto = [
  { src: '/img/port-23.webp', w: 960, h: 636, data: 'Taubaté · shopping', alt: 'Centinaia di persone seguono la lezione in un centro commerciale in Brasile.' },
  { src: '/img/mkt-1.webp', w: 774, h: 1032, data: 'Urban Mix', alt: 'Trajano su un palco durante un evento in Brasile.' },
  { src: '/img/port-5.webp', w: 960, h: 720, data: 'Formazione istruttori', alt: 'Gruppo di istruttori in formazione.' },
];
---

<section class="sezione chisono" aria-labelledby="chisono-titolo">
  <div class="battuta" aria-hidden="true">
    <span></span><span></span><span></span><span></span>
  </div>
  <p class="util">Chi sono</p>
  <h2 id="chisono-titolo" class="sr-only">Chi sono</h2>

  <div class="chisono__flusso">
    <p>
      Ho iniziato a insegnare in Brasile nel 2013. Non venivo dal fitness:
      venivo dal marketing e dagli eventi.
    </p>

    <p class="chisono__rilievo">
      Forse è per questo che ho sempre pensato a una lezione come a uno
      spettacolo — qualcosa che deve tenere le persone dentro, non solo
      farle sudare.
    </p>

    <figure class="chisono__foto chisono__foto--larga">
      <img src={foto[0].src} width={foto[0].w} height={foto[0].h} alt={foto[0].alt} loading="lazy" decoding="async" />
      <figcaption class="util">{foto[0].data}</figcaption>
    </figure>

    <p>
      Nel 2015 ho fondato Urban Mix, una metodologia di danza collettiva. In
      sette anni ho formato più di cinquecento istruttori in tutto il Brasile
      e ho portato lezioni in centri commerciali ed eventi con centinaia di
      persone in piazza.
    </p>

    <div class="chisono__coppia">
      {
        foto.slice(1).map((f) => (
          <figure class="chisono__foto">
            <img src={f.src} width={f.w} height={f.h} alt={f.alt} loading="lazy" decoding="async" />
            <figcaption class="util">{f.data}</figcaption>
          </figure>
        ))
      }
    </div>

    <p>
      Nel 2022 sono arrivato in Italia. Cittadino italiano, ma con tutto da
      ricominciare: lingua, rete, credibilità. Ho ricominciato dalla sala,
      come si ricomincia sempre.
    </p>

    <p>
      Oggi a Catania insegno con il mio format, il Cardio Dance Brasil.
    </p>

    <p class="chisono__chiusura">E ho ancora spazio in agenda.</p>
  </div>
</section>

<style>
  .chisono__flusso {
    display: grid;
    gap: var(--spazio-blocco);
    margin-top: var(--spazio-riga);
  }

  /* A frase que explica a página inteira, em display. */
  .chisono__rilievo {
    font-family: var(--font-display);
    font-stretch: var(--largura-titolo);
    font-weight: 700;
    font-size: clamp(1.4rem, 3.4vw, 2.15rem);
    line-height: 1.14;
    letter-spacing: -0.015em;
    max-width: 30ch;
  }

  .chisono__chiusura {
    font-family: var(--font-display);
    font-stretch: var(--largura-titolo);
    font-weight: 800;
    font-size: clamp(1.3rem, 3vw, 1.9rem);
    line-height: 1.1;
    color: var(--accento);
    max-width: 24ch;
  }

  .chisono__foto img {
    width: 100%;
    border-radius: var(--raggio);
  }

  .chisono__foto figcaption {
    margin-top: 0.6rem;
    color: var(--testo-secondario);
  }

  .chisono__coppia {
    display: grid;
    gap: var(--spazio-riga);
  }

  @media (min-width: 56rem) {
    /* As fotos entram entre parágrafos, em posições diferentes —
       não numa grade regular. Assimetria deliberada. */
    .chisono__flusso {
      grid-template-columns: minmax(0, 34rem) minmax(0, 1fr);
      gap: var(--spazio-blocco) var(--spazio-sezione);
      align-items: start;
    }
    .chisono__rilievo {
      grid-column: 2;
      grid-row: 1 / span 2;
      padding-top: 2rem;
    }
    .chisono__foto--larga,
    .chisono__coppia {
      grid-column: 1 / -1;
    }
    .chisono__foto--larga img {
      max-height: 30rem;
      object-fit: cover;
    }
    .chisono__coppia {
      grid-template-columns: repeat(2, minmax(0, 24rem));
      gap: var(--spazio-blocco);
    }
    .chisono__chiusura {
      grid-column: 1 / -1;
    }
  }
</style>
