---
// Os rostos fazem o trabalho. Sem nome inventado, sem estrela, sem
// aspas gigante de decoração.
//
// preload="none" nos três, obrigatoriamente: é o ponto mais pesado
// da página depois do hero. Sem isso o LCP vai embora.
//
// PENDENTE: são os vídeos que existem no repositório. Os três
// depoimentos verticais definitivos são pendência do Trajano.
const testimonianze = [
  { src: '/video/entrevista.mp4', poster: '/img/trajano-salto.webp' },
  { src: '/video/aula.mp4', poster: '/img/port-23.webp' },
];
---

<section data-reveal class="sezione testimonianze" aria-labelledby="testimonianze-titolo">
  <div class="battuta" aria-hidden="true">
    <span></span><span></span><span></span><span></span>
  </div>
  <p class="util">Cosa dicono</p>

  <h2 id="testimonianze-titolo" class="titolo">
    Non chiedo di credermi. Guarda loro.
  </h2>

  <ul class="carosello" role="list" tabindex="0" aria-label="Testimonianze">
    {
      testimonianze.map((t) => (
        <li class="carosello__voce">
          <video controls preload="none" poster={t.poster} playsinline>
            <source src={t.src} type="video/mp4" />
          </video>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .carosello {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 72%;
    gap: var(--spazio-riga);
    margin-top: var(--spazio-blocco);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    margin-inline: calc(var(--margine) * -1);
    padding-inline: var(--margine);
    padding-bottom: var(--spazio-riga);
    scrollbar-width: thin;
  }

  .carosello__voce {
    scroll-snap-align: start;
  }

  .carosello video {
    width: 100%;
    aspect-ratio: 9 / 16;
    object-fit: cover;
    background: var(--basalto);
    border-radius: var(--raggio);
  }

  /* Lado a lado no desktop, carrossel no celular. */
  @media (min-width: 56rem) {
    .carosello {
      grid-auto-flow: row;
      grid-template-columns: repeat(auto-fit, minmax(0, 20rem));
      overflow-x: visible;
      margin-inline: 0;
      padding-inline: 0;
      gap: var(--spazio-blocco);
      max-width: 66rem;
    }
  }
</style>
