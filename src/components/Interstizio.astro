---
// Respiro entre seções. Um componente, quatro textos.
// Altura menor que a tela cheia: é respiro, não seção.
// A entrada de cada um (deslocamento ou máscara) é da Fase 3.

interface Props {
  testo: string;
  /** Marca de qual dos quatro é, para a Fase 3 dar entradas distintas. */
  indice: 1 | 2 | 3 | 4;
  /** Interstícios repetitivos saem no celular. Ver PLANO.md seção 4. */
  soloDesktop?: boolean;
}

const { testo, indice, soloDesktop = false } = Astro.props;
---

<aside
  class:list={['interstizio', 'su-basalto', { 'solo-desktop': soloDesktop }]}
  data-reveal
  data-interstizio={indice}
>
  <p class="interstizio__testo">{testo}</p>
</aside>

<style>
  .interstizio {
    background: var(--sfondo);
    color: var(--testo);
    padding: clamp(3rem, 8vw, 5.5rem) var(--margine);
    /* Menor que a tela cheia, sempre. */
    min-height: 48svh;
    display: flex;
    align-items: center;
  }

  .interstizio__testo {
    font-family: var(--font-display);
    font-stretch: var(--largura-titolo);
    font-weight: 800;
    font-size: var(--passo-m);
    line-height: 1.06;
    letter-spacing: -0.02em;
    /* Alinhado à esquerda. O briefing proíbe centralizar. */
    max-width: 24ch;
  }

  @media (min-width: 56rem) {
    .interstizio {
      min-height: 42svh;
    }
    .interstizio__testo {
      max-width: 34ch;
    }
  }

  /* ── ENTRADAS (fase 3, spec 3.3) ────────────────────────────────
     Cada interstício faz um movimento próprio: são momentos, não
     decoração repetida. Os quatro alternam entre revelação por
     máscara e deslocamento horizontal leve.                        */

  /* 1 e 3 — deslocamento horizontal leve, da esquerda. */
  :global(.movimento-pronto) [data-interstizio='1'] .interstizio__testo,
  :global(.movimento-pronto) [data-interstizio='3'] .interstizio__testo {
    opacity: 0;
    transform: translateX(-1.5rem);
    transition:
      opacity 620ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 620ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* 2 e 4 — revelação por máscara, de baixo para cima. */
  :global(.movimento-pronto) [data-interstizio='2'] .interstizio__testo,
  :global(.movimento-pronto) [data-interstizio='4'] .interstizio__testo {
    clip-path: inset(0 0 100% 0);
    transform: translateY(0.75rem);
    transition:
      clip-path 760ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 760ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(.movimento-pronto) .interstizio.e-entrato .interstizio__testo {
    opacity: 1;
    transform: none;
    clip-path: inset(0 0 0 0);
  }

  /* Cortes de celular do PLANO.md, seção 4. */
  .solo-desktop {
    display: none;
  }

  @media (min-width: 56rem) {
    .solo-desktop {
      display: flex;
    }
  }
</style>
