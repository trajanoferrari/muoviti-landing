---
import { WHATSAPP } from '../lib/contatto';

// A foto tem 960×636. Cobre bem o celular em densidade 2×, mas não
// cobre uma faixa sangrando de 1440px no desktop — por isso ali ela
// ocupa uma coluna de ~46%, sangrando só à esquerda e no topo.
// Ver PLANO.md, Fase 2, seção G.
const FOTO = { src: '/img/hero-v3.webp', w: 960, h: 636 };
---

<header class="hero su-basalto">
  <div class="hero__foto">
    <img
      src={FOTO.src}
      width={FOTO.w}
      height={FOTO.h}
      alt="Trajano Ferrari conduce una lezione davanti a centinaia di persone in movimento."
      fetchpriority="high"
      decoding="async"
    />
  </div>

  <div class="hero__testo">
    <p class="util">Cardio Dance Brasil · Catania</p>

    <h1 class="hero__titolo">Un'ora in cui nessuno guarda l'orologio.</h1>

    <p class="hero__sub">
      Cardio Dance Brasil a Catania.<br />
      Sala piena tre mattine a settimana, tutto l'anno.
    </p>

    <a class="cta" href={WHATSAPP} rel="noopener">Parliamone su WhatsApp</a>
  </div>
</header>

<style>
  .hero {
    background: var(--sfondo);
    color: var(--testo);
    display: grid;
  }

  /* CELULAR — foto em cima sangrando, texto em bloco sólido embaixo.
     Texto sobre foto num hero de celular quase sempre reprova no
     contraste; o bloco sólido resolve sem escurecer a imagem até
     virar cinza. */
  .hero__foto img {
    width: 100%;
    height: 46svh;
    object-fit: cover;
    /* O ponto de interesse é ele, à direita do centro. */
    object-position: 68% 38%;
  }

  .hero__testo {
    padding: var(--spazio-blocco) var(--margine) var(--spazio-sezione);
  }

  .hero__titolo {
    font-size: var(--passo-hero);
    font-stretch: var(--largura-display);
    letter-spacing: -0.03em;
    margin-block: var(--spazio-riga) var(--spazio-blocco);
    max-width: 18ch;
  }

  .hero__sub {
    font-size: var(--passo-lead);
    line-height: 1.4;
    max-width: var(--misura-stretta);
    margin-bottom: var(--spazio-blocco);
  }

  /* DESKTOP — assimetria deliberada: a foto NÃO é metade exata.
     Ocupa 46% e o texto respira no resto. */
  @media (min-width: 56rem) {
    .hero {
      grid-template-columns: 46fr 54fr;
      align-items: stretch;
      min-height: 88svh;
    }

    .hero__foto img {
      height: 100%;
      min-height: 88svh;
      object-position: 62% 40%;
    }

    .hero__testo {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
      padding: var(--spazio-sezione) var(--margine);
    }

    /* Sem isto o CTA esticaria por toda a coluna e viraria faixa. */
    .hero__testo .cta {
      align-self: flex-start;
    }
  }
</style>
